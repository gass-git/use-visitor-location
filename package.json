{
  "name": "use-visitor-location",
  "version": "1.3.2",
  "description": "React hook that returns the geographic location of visitors and much more.",
  "keywords": [
    "react",
    "react-hook",
    "geolocation",
    "location",
    "geoip",
    "ip-geolocation",
    "user-location",
    "visitor-location",
    "localization",
    "frontend"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gass-git/use-visitor-location"
  },
  "license": "MIT",
  "author": "gass-git",
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "rimraf --glob \"*.tgz\" && npm run build && npm pack && npm link",
    "build": "rimraf dist && rollup -c --bundleConfigAsCjs",
    "tests": "vitest"
  },
  "dependencies": {
    "axios": "^1.13.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}